# Copy to .env and fill in. Every value is optional: without an LLM key the app still answers
# the supported question types through its deterministic paths (rules + retrieval).

# LLM provider: groq | gemini | ollama | none
LLM_PROVIDER=groq
GROQ_API_KEY=            # free key: https://console.groq.com/keys
GEMINI_API_KEY=          # free key: https://aistudio.google.com/apikey
# LLM_MODEL=openai/gpt-oss-120b       # override the provider default
# LLM_BASE_URL=                       # any OpenAI-compatible endpoint
# LLM_TIMEOUT_S=60

# Voice questions (speech-to-text, Whisper). Uses GROQ_API_KEY by default.
# STT_MODEL=whisper-large-v3-turbo

# Accounts: password + 6-digit code sent by email (2 factors).
# Without SMTP the app runs in DEMO mode: the code is printed in the server terminal only.
# Gmail: enable 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
AUTH_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=               # your.address@gmail.com
SMTP_PASSWORD=           # 16-character app password
SMTP_FROM=               # optional, defaults to SMTP_USER

# Guardrails
SQL_MAX_ROWS=300
SQL_TIMEOUT_S=5

# Retrieval / observability / cache
RAG_TOP_K=8
TRACE_DIR=traces
CACHE_DIR=.cache
CACHE_ENABLED=1
